      <column caption='Region' datatype='string' name='[Calculation_1098174084886528]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [country] IN (&quot;India&quot;,&quot;Pakistan&quot;,&quot;Bangladesh&quot;,&quot;Sri Lanka&quot;,&quot;Nepal&quot;,&quot;Bhutan&quot;,&quot;Maldives&quot;,&quot;Afghanistan&quot;) THEN &quot;South Asia&quot;&#13;&#10;&#13;&#10;ELSEIF [country] IN (&quot;China&quot;,&quot;Japan&quot;,&quot;South Korea&quot;,&quot;Hong Kong&quot;,&quot;Hong Kong SAR, China&quot;,&quot;Macao&quot;,&quot;Macao SAR, China&quot;,&quot;Taiwan&quot;,&quot;Singapore&quot;,&quot;Malaysia&quot;,&quot;Thailand&quot;,&quot;Indonesia&quot;,&quot;Vietnam&quot;,&quot;Philippines&quot;) THEN &quot;East &amp; Southeast Asia&quot;&#13;&#10;&#13;&#10;ELSEIF [country] IN (&quot;United States&quot;,&quot;United States of America&quot;,&quot;Canada&quot;) THEN &quot;North America&quot;&#13;&#10;&#13;&#10;ELSEIF [country] IN (&quot;Brazil&quot;,&quot;Argentina&quot;,&quot;Chile&quot;,&quot;Colombia&quot;,&quot;Peru&quot;,&quot;Mexico&quot;,&quot;Uruguay&quot;,&quot;Ecuador&quot;,&quot;Venezuela&quot;) THEN &quot;Latin America&quot;&#13;&#10;&#13;&#10;ELSEIF [country] IN (&quot;United Kingdom&quot;,&quot;France&quot;,&quot;Germany&quot;,&quot;Italy&quot;,&quot;Spain&quot;,&quot;Netherlands&quot;,&quot;Switzerland&quot;,&quot;Sweden&quot;,&quot;Denmark&quot;,&quot;Norway&quot;,&quot;Finland&quot;,&quot;Belgium&quot;,&quot;Austria&quot;,&quot;Ireland&quot;,&quot;Portugal&quot;,&quot;Poland&quot;,&quot;Czech Republic&quot;,&quot;Greece&quot;,&quot;Hungary&quot;,&quot;Romania&quot;,&quot;Russia&quot;,&quot;Russian Federation&quot;) THEN &quot;Europe&quot;&#13;&#10;&#13;&#10;ELSEIF [country] IN (&quot;Australia&quot;,&quot;New Zealand&quot;) THEN &quot;Oceania&quot;&#13;&#10;&#13;&#10;ELSEIF [country] IN (&quot;South Africa&quot;,&quot;Egypt&quot;,&quot;Nigeria&quot;,&quot;Kenya&quot;,&quot;Ghana&quot;,&quot;Morocco&quot;,&quot;Tunisia&quot;,&quot;Uganda&quot;,&quot;Ethiopia&quot;) THEN &quot;Africa&quot;&#13;&#10;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
      </column>
