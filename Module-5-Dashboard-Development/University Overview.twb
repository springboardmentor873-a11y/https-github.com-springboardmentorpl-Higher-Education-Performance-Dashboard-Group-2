      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (university_final_dataset)' name='federated.1ildcza05780k6124zot10ufh088' />
          </datasources>
          <datasource-dependencies datasource='federated.1ildcza05780k6124zot10ufh088'>
            <column caption='Region Clean' datatype='string' name='[Calculation_291045168495927296]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([region]) THEN &quot;Not Provided&quot;&#13;&#10;ELSE [region]&#13;&#10;END' />
            </column>
            <column caption='Avg Academic Reputation' datatype='real' name='[Calculation_291045168502800390]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([academic_reputation_score])' />
            </column>
            <column caption='Academic Reputation Score' datatype='real' name='[academic_reputation_score]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Calculation_291045168495927296]' derivation='None' name='[none:Calculation_291045168495927296:nk]' pivot='key' type='nominal' />
