      <aliases enabled='yes' />
      <column caption='Reset Button' datatype='string' name='[Calculation_0567392019873792]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Reset Filters&quot;' />
      </column>
      <column caption='Top Performing Country' datatype='string' name='[Calculation_2143266009657344]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [rank_numeric] = { FIXED [country] : MIN([rank_numeric]) }&#13;&#10;THEN [country]&#13;&#10;END' />
      </column>
      <column caption='Avg Employment Outcomes' datatype='real' name='[Calculation_2143266010320897]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([employment_outcomes])' />
      </column>
      <column caption='Region Clean' datatype='string' name='[Calculation_291045168495927296]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([region]) THEN &quot;Not Provided&quot;&#13;&#10;ELSE [region]&#13;&#10;END' />
      </column>
      <column caption='Top Global Ranking' datatype='integer' name='[Calculation_291045168496209921]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN([rank_numeric])' />
      </column>
      <column caption='Total Universities' datatype='integer' name='[Calculation_291045168496283650]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([institution])' />
      </column>
      <column caption='Avg Overall Score' datatype='real' name='[Calculation_291045168496418819]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([overall_score])' />
      </column>
      <column caption='Avg International Students %' datatype='real' name='[Calculation_291045168496570372]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([international_student_percentage])' />
      </column>
      <column caption='Avg Research Productivity' datatype='real' name='[Calculation_291045168496693253]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([research_productivity_index])' />
      </column>
      <column caption='Avg Academic Reputation' datatype='real' name='[Calculation_291045168502800390]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([academic_reputation_score])' />
