</connection>
<column datatype='string' datatype-customized='true' name='[University]' role='dimension' type='nominal' /><column datatype='string' datatype-customized='true' name='[Country]' role='dimension' type='nominal' /><column datatype='real' datatype-customized='true' name='[Global_Ranking_Score]' role='measure' type='quantitative' /><column datatype='real' datatype-customized='true' name='[Academic_Excellence_Score]' role='measure' type='quantitative' /><column datatype='real' datatype-customized='true' name='[Research_Impact_Score]' role='measure' type='quantitative' /><column datatype='real' datatype-customized='true' name='[Faculty_to_Student_Ratio]' role='measure' type='quantitative' /><column datatype='real' datatype-customized='true' name='[International_Student_Percentage]' role='measure' type='quantitative' /><column datatype='real' datatype-customized='true' name='[Academic_Reputation_KPI]' role='measure' type='quantitative' /><column datatype='real' datatype-customized='true' name='[Research_Productivity_Index]' role='measure' type='quantitative' /><column datatype='real' datatype-customized='true' name='[scores_research]' role='measure' type='quantitative' /><column datatype='real' datatype-customized='true' name='[scores_citations]' role='measure' type='quantitative' /><column datatype='real' datatype-customized='true' name='[stats_number_students]' role='measure' type='quantitative' /><column datatype='real' datatype-customized='true' name='[female_percentage]' role='measure' type='quantitative' /><column datatype='real' datatype-customized='true' name='[male_percentage]' role='measure' type='quantitative' /><column datatype='real' datatype-customized='true' name='[Overall_QS]' role='measure' type='quantitative' /><column datatype='real' datatype-customized='true' name='[Overall_THE]' role='measure' type='quantitative' /><column datatype='real' datatype-customized='true' name='[Global_Ranking_Score (bin)]' role='measure' type='quantitative' /><column datatype