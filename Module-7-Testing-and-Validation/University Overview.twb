      <column caption='Rank Movement' datatype='real' name='[Calculation_1188613862313984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([qs_Previous Rank]) OR ISNULL([qs_2026 Rank]) THEN&#13;&#10;    NULL&#13;&#10;ELSE&#13;&#10;    [qs_Previous Rank] - [qs_2026 Rank]&#13;&#10;END' />
      </column>
      <column caption='Rank Movement Status' datatype='string' name='[Calculation_1188613862621185]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Calculation_1188613862313984]) THEN&#13;&#10;    &quot;No Previous Rank&quot;&#13;&#10;ELSEIF [Calculation_1188613862313984] &gt; 0 THEN&#13;&#10;    &quot;Improved&quot;&#13;&#10;ELSEIF [Calculation_1188613862313984] &lt; 0 THEN&#13;&#10;    &quot;Declined&quot;&#13;&#10;ELSE&#13;&#10;    &quot;No Change&quot;&#13;&#10;END' />
