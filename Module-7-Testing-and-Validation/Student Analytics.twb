      <column caption='International Student Count' datatype='real' name='[Calculation_0208402153463810]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([the_Student Population] * [the_International Students])' />
      </column>
      <column caption='Domestic Student Count' datatype='real' name='[Calculation_0208402155225091]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([the_Student Population] * (1 - [the_International Students]))' />
      </column>
      <column caption='Student Percentage' datatype='real' default-format='p0.00%' name='[Calculation_0208402213036037]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0208402155225091] /&#13;&#10;([Calculation_0208402155225091] + [Calculation_0208402153463810])' />
      </column>
      <column caption='path' datatype='integer' name='[Calculation_0208402250489864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='curve' datatype='real' name='[Calculation_0208402251067401]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SIN([Calculation_0208402250489864]* PI())'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Flow Position' datatype='real' name='[Calculation_0208402252107786]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0208402251067401] * SUM([the_Student Population])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Rank Movement' datatype='real' name='[Calculation_1188613862313984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([qs_Previous Rank]) OR ISNULL([qs_2026 Rank]) THEN&#13;&#10;    NULL&#13;&#10;ELSE&#13;&#10;    [qs_Previous Rank] - [qs_2026 Rank]&#13;&#10;END' />
      </column>
      <column caption='Rank Movement Status' datatype='string' name='[Calculation_1188613862621185]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Calculation_1188613862313984]) THEN&#13;&#10;    &quot;No Previous Rank&quot;&#13;&#10;ELSEIF [Calculation_1188613862313984] &gt; 0 THEN&#13;&#10;    &quot;Improved&quot;&#13;&#10;ELSEIF [Calculation_1188613862313984] &lt; 0 THEN&#13;&#10;    &quot;Declined&quot;&#13;&#10;ELSE&#13;&#10;    &quot;No Change&quot;&#13;&#10;END' />
      </column>
      <column caption='Rank Movement Display' datatype='string' name='[Calculation_1188613862789122]' role='dimension' type='nominal'>
