          <formatted-text>
            <run bold='true' fontcolor='#735878' fontname='Segoe UI' fontsize='12'>Domestic vs International Student Distribution</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='university_kpi_dataset' name='federated.16m5wrv0pyyym018fu9rq02mipax' />
